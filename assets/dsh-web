#!/usr/bin/env bash
# dsh-web — open the DeepSeek Harness Web GUI in its own browser window.
#
# When a DSH Web server already answers on the target port, reuse it and open
# its authenticated URL (from this launcher's log when it started the server,
# otherwise the plain origin). When none answers, start `dsh web` detached,
# wait for the authenticated URL it prints, and hand that URL to Firefox in a
# new window. Nothing here depends on the calling shell's PATH.
#
# Usage: dsh-web [--status] [--stop] [--no-open] [--help]
# Env:   DSH_WEB_PORT (default 3080), DSH_WEB_HOST (default 127.0.0.1),
#        DSH_WEB_DSH_BIN, DSH_WEB_NO_OPEN=1, DSH_WEB_START_TIMEOUT (seconds)

set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
VIEWER="$SCRIPT_DIR/dsh-web-view"

PORT="${DSH_WEB_PORT:-3080}"
HOST="${DSH_WEB_HOST:-127.0.0.1}"
ORIGIN="http://${HOST}:${PORT}/"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dsh-web"
LOG_FILE="${STATE_DIR}/web-${PORT}.log"
PID_FILE="${STATE_DIR}/web-${PORT}.pid"
LOCK_FILE="${STATE_DIR}/web-${PORT}.lock"
START_TIMEOUT="${DSH_WEB_START_TIMEOUT:-90}"

say() { printf '%s\n' "$*"; }

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -a "DSH Web" -i dsh-web "$1" "${2:-}" >/dev/null 2>&1 || true
	fi
}

# Add a directory to PATH once, when it exists.
add_path_dir() {
	case ":$PATH:" in
	*":$1:"*) return 0 ;;
	esac
	[ -d "$1" ] || return 0
	PATH="$1:$PATH"
}

# Desktop sessions start with a minimal PATH; restore the usual user bins and
# prefer the newest nvm-managed Node. The distro Node (18 on Ubuntu 24.04) is
# too old for dsh, which needs node:util's parseEnv (Node 22+).
bootstrap_path() {
	add_path_dir "$HOME/.local/bin"
	add_path_dir "$SCRIPT_DIR"
	local latest
	latest="$(
		for dir in "$HOME"/.nvm/versions/node/*/bin; do
			[ -x "$dir/node" ] && printf '%s\n' "$dir"
		done | sort -V | tail -n 1
	)"
	[ -n "$latest" ] && add_path_dir "$latest"
}

# Locate the dsh executable without relying on the launcher environment.
resolve_dsh() {
	local candidate
	if [ -n "${DSH_WEB_DSH_BIN:-}" ] && [ -x "${DSH_WEB_DSH_BIN}" ]; then
		printf '%s\n' "${DSH_WEB_DSH_BIN}"
		return 0
	fi
	if candidate="$(command -v dsh 2>/dev/null)" && [ -n "$candidate" ]; then
		printf '%s\n' "$candidate"
		return 0
	fi
	candidate="$(ls -t "$HOME"/.npm/_npx/*/node_modules/.bin/dsh 2>/dev/null | head -n 1 || true)"
	if [ -n "$candidate" ] && [ -x "$candidate" ]; then
		printf '%s\n' "$candidate"
		return 0
	fi
	return 1
}

http_code() {
	curl -sS -o /dev/null -w '%{http_code}' --max-time 2 "$1" 2>/dev/null || true
}

# Any HTTP answer (including 401) means a server owns the port.
is_up() {
	local code
	code="$(http_code "$ORIGIN")"
	[ -n "$code" ] && [ "$code" != "000" ]
}

read_pid() {
	[ -r "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null
}

pid_alive() {
	[ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

logged_url() {
	local url
	[ -r "$LOG_FILE" ] || return 1
	url="$(grep -aoE 'dsh web: https?://[^[:space:]]+' "$LOG_FILE" 2>/dev/null |
		tail -n 1 | sed 's/^dsh web: //')"
	[ -n "$url" ] || return 1
	printf '%s\n' "$url"
}

viewer_usable() {
	[ -x "$VIEWER" ] || return 1
	/usr/bin/python3 -c 'import gi; gi.require_version("Gtk", "3.0"); gi.require_version("WebKit2", "4.1")' >/dev/null 2>&1
}

open_target() {
	local target="$1" viewer_log
	if [ "${DSH_WEB_NO_OPEN:-0}" = "1" ]; then
		say "$target"
		return 0
	fi
	if [ "${DSH_WEB_BROWSER:-auto}" != "firefox" ] && viewer_usable; then
		mkdir -p "$STATE_DIR" 2>/dev/null || true
		chmod 700 "$STATE_DIR" 2>/dev/null || true
		viewer_log="${STATE_DIR}/viewer.log"
		setsid "$VIEWER" "$target" >>"$viewer_log" 2>&1 &
		return 0
	fi
	if command -v firefox >/dev/null 2>&1; then
		setsid firefox --new-window "$target" >/dev/null 2>&1 &
		return 0
	fi
	if command -v xdg-open >/dev/null 2>&1; then
		setsid xdg-open "$target" >/dev/null 2>&1 &
		return 0
	fi
	say "$target"
}

start_instance() {
	local dsh="$1" pid url deadline now
	mkdir -p "$STATE_DIR" 2>/dev/null || {
		notify "DSH Web 无法启动" "无法创建状态目录 $STATE_DIR"
		return 1
	}
	chmod 700 "$STATE_DIR" 2>/dev/null || true
	: >"$LOG_FILE" 2>/dev/null && chmod 600 "$LOG_FILE" 2>/dev/null

	setsid "$dsh" web --port "$PORT" --no-open >>"$LOG_FILE" 2>&1 &
	pid=$!
	printf '%s\n' "$pid" >"$PID_FILE"

	deadline=$(( $(date +%s) + START_TIMEOUT ))
	while :; do
		if url="$(logged_url)"; then
			open_target "$url"
			return 0
		fi
		if ! kill -0 "$pid" 2>/dev/null; then
			break
		fi
		now=$(date +%s)
		[ "$now" -ge "$deadline" ] && break
		sleep 0.3
	done
	if is_up; then
		open_target "$ORIGIN"
		return 0
	fi
	notify "DSH Web 启动失败" "查看日志：$LOG_FILE"
	say "dsh-web: 启动失败，日志见 $LOG_FILE" >&2
	tail -n 20 "$LOG_FILE" >&2 2>/dev/null || true
	return 1
}

stop_instance() {
	local pid
	pid="$(read_pid)"
	if pid_alive "$pid"; then
		kill "$pid" 2>/dev/null || true
		for _ in $(seq 1 50); do
			pid_alive "$pid" || break
			sleep 0.1
		done
		pid_alive "$pid" && kill -9 "$pid" 2>/dev/null || true
		rm -f "$PID_FILE"
		say "dsh-web: 已停止实例 (pid ${pid})"
	else
		rm -f "$PID_FILE"
		say "dsh-web: 没有由本快捷方式启动的实例"
	fi
}

usage() {
	cat <<'EOF'
用法: dsh-web [选项]

不带选项时打开 DSH Web：已有实例则复用，否则在后台启动一个实例。

选项:
  --status    显示当前端口上的运行状态
  --stop      停止由本快捷方式启动的实例
  --no-open   只打印访问 URL，不打开浏览器
  -h, --help  显示本帮助

环境变量:
  DSH_WEB_PORT           端口（默认 3080）
  DSH_WEB_HOST           主机（默认 127.0.0.1）
  DSH_WEB_DSH_BIN        指定 dsh 可执行文件
  DSH_WEB_START_TIMEOUT  启动等待秒数（默认 90）
  DSH_WEB_BROWSER        auto（默认，独立窗口）| firefox
EOF
}

MODE="open"
for arg in "$@"; do
	case "$arg" in
	--status | -s) MODE="status" ;;
	--stop) MODE="stop" ;;
	--no-open) export DSH_WEB_NO_OPEN=1 ;;
	-h | --help) usage; exit 0 ;;
	*)
		say "dsh-web: 未知参数 $arg" >&2
		usage >&2
		exit 2
		;;
	esac
done

bootstrap_path

case "$MODE" in
status)
	if is_up; then
		pid="$(read_pid)"
		say "dsh-web: 运行中 ${ORIGIN}"
		pid_alive "$pid" && say "dsh-web: 本快捷方式实例 pid ${pid}"
	else
		say "dsh-web: 未运行 (${ORIGIN})"
	fi
	exit 0
	;;
stop)
	stop_instance
	exit 0
	;;
esac

if is_up; then
	pid="$(read_pid)"
	target="$ORIGIN"
	if pid_alive "$pid"; then
		url="$(logged_url)" && target="$url"
	fi
	open_target "$target"
	exit 0
fi

dsh="$(resolve_dsh)" || {
	notify "找不到 dsh" "请安装 @deepseek-ai/dsh 或设置 DSH_WEB_DSH_BIN"
	say "dsh-web: 找不到 dsh 可执行文件；请安装 @deepseek-ai/dsh 或设置 DSH_WEB_DSH_BIN" >&2
	exit 1
}
command -v node >/dev/null 2>&1 || {
	notify "找不到 Node.js" "dsh 需要 Node.js 运行时"
	say "dsh-web: 找不到 node，无法启动 dsh web" >&2
	exit 1
}

mkdir -p "$STATE_DIR" 2>/dev/null || true
# Hold the start lock on fd 9 for this process's lifetime. Do not add a stderr
# redirection here: redirections on a bare `exec` persist for the whole script.
exec 9>"$LOCK_FILE" || true
if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
	notify "DSH Web 正在启动" "请稍候再试"
	exit 0
fi

start_instance "$dsh"
